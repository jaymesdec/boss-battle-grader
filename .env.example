# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Franklin Canvas OAuth (required)
CANVAS_DOMAIN=franklinjc.instructure.com
CANVAS_BASE_URL=https://franklinjc.instructure.com
CANVAS_CLIENT_ID=replace-with-canvas-developer-key-id
CANVAS_CLIENT_SECRET=replace-with-canvas-developer-key-secret

# Optional fallback token for local testing (not recommended in production)
CANVAS_API_TOKEN=

# Optional Google OAuth (only needed for Google Docs/Slides submission parsing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic (if AI grading/feedback features are used)
ANTHROPIC_API_KEY=
